function toExamineDetail(id) {
	var safeId = String(id == null ? '' : id).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
	var html = '<div style="background:#fafafa;border-bottom:1px solid #f0f0f0;padding:12px 14px;display:flex;align-items:center;flex-wrap:nowrap;gap:10px;">'
		+ '<span style="flex-shrink:0;font-size:13px;color:#666;font-weight:500;white-space:nowrap;">审批单号</span>'
		+ '<input type="text" readonly value="'+safeId+'" style="flex:1;min-width:0;box-sizing:border-box;border:1px solid #e6e6e6;background:#fff;padding:7px 10px;border-radius:4px;font-size:13px;color:#333;" '
		+ 'onclick="this.select();try{document.execCommand(\'copy\');layer.msg(\'已复制\',{time:1200});}catch(e){layer.msg(\'请手动复制\');}" title="点击复制"/>'
		+ '</div>';
	html += '<div style="max-height:380px;overflow-y:auto;padding:12px 14px 16px 14px;">';
	html += '<ul class="layui-timeline" style="margin:0;">';
	$.ajax({
		url: base_url + 'PrmPorts/getApprovalProcess',
		type: 'post',
		data: {number: id,type: 1},
		dataType: 'json',
		async: false,
		success: function (r) {
			if(r.code==1 && r.data && r.data.length >= 1){
				for (var i=0;i<r.data.length;i++){
					var row = r.data[i];
					var name = row.name || '';
					var addTime = row.addTime || '';
					var icon = "&#x1005;";
					// 与已完成节点统一：「审批人 · 状态」单行；多人时接口已用顿号拼接，自动换行不断字
					var stateStr = row.state || '';
					var assigneeStr = row.assignee || '';
					var detailLine = assigneeStr
						? (assigneeStr + (stateStr ? ' <span style="color:#bbb;">·</span> ' + stateStr : ''))
						: stateStr;
					var htmlP = '<p style="margin:8px 0 0 0;font-size:13px;color:#555;line-height:1.55;word-wrap:break-word;">' + detailLine + '</p>';
					if((r.data.length-1)==i){
						icon="&#xe63d;";
					}
					if (row.throughRule) {
						htmlP += '<p style="color:#999;font-size:12px;margin-top:8px;line-height:1.45;padding:6px 8px;background:#f7f7f7;border-radius:4px;">' + row.throughRule + '</p>';
					}
					var titleBlock = '<div style="margin:0;display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:nowrap;">'
						+ '<div style="font-size:14px;color:#333;font-weight:600;line-height:1.4;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'+name+'</div>'
						+ '<div style="font-size:12px;color:#999;flex-shrink:0;white-space:nowrap;letter-spacing:0.02em;">'+addTime+'</div>'
						+ '</div>';
					var itemBorder = (i < r.data.length - 1) ? 'padding-bottom:14px;border-bottom:1px solid #f2f2f2;' : 'padding-bottom:4px;';
					html+="<li class=\"layui-timeline-item\" style=\"padding-bottom:2px;\">\n" +
						"    <i class=\"layui-icon layui-timeline-axis\" style=\"color:#5FB878;\">"+icon+"</i>\n" +
						"    <div class=\"layui-timeline-content layui-text\" style=\""+itemBorder+"\">\n" +
						"      " + titleBlock + "\n" + htmlP+
						" 	 </div>"+
						" 	 </li>"
					;
				}
			} else {
				html += '<li class="layui-timeline-item"><div class="layui-timeline-content layui-text" style="color:#999;font-size:13px;">暂无审批记录</div></li>';
			}
		}
	});
	html = html + "</ul></div>";

	layer.open({
		title: '<span style="font-size:15px;font-weight:600;">审批详情</span>',
		type: 1,
		area: ['420px', '520px'],
		content: html,
		shade: 0.35,
		resize: false
	});
}
//授权审核
function toIsExamine(id){
	layer.confirm('确定审核通过吗？', {btn: ["通过", "驳回", "取消"]}, function (index1) {
		layer.close(index1);
		dealExamine(id,10);
	},function (index2) {
		layer.close(index2);
		dealExamine(id,5);
	});
}

//处理审核
function dealExamine(id,type){
	$.ajax({
		url: base_url + 'planNew/dealExamine',
		type: 'post',
		data: {id: id, type: type},
		dataType: 'json',
		success: function (r) {
			if(parseInt(r.code) === 0){
				layer.alert('操作成功！');
			}else{
				layer.alert('操作失败，请刷新后重试！');
			}
			tableIns.reload();
		},
		error: function () {
			layer.alert('操作失败，请刷新后重试！');
		}
	});
}
