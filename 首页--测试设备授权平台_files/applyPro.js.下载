//部分产品线需要隐藏区域
function hideArea(version) {
    let areaHtml = '<option value="">请选择区域</option>',
        office_html = '<option value="">请选择办事处</option>',
        office_type = false;

    if (!dataArea.length) {
        return false
    }

    switch (version) {
        case '3.2.40':
            //隐藏海外区域
            $.each(dataArea, function (i, item) {
                if (item.area != 'EMEA(中东/非洲/欧洲)' && item.area != 'SEA东南亚') {
                    areaHtml += '<option value="' + item.area + '">' + item.area + '</option>';
                    if (office_type === false) {
                        $.each(item.office, function (j, dump) {
                            office_html += '<option value="' + dump + '">' + dump + '</option>';
                        })
                        office_type = true;
                    }
                }
            });
            break;
        default:
            if (office2Data.area) {	//办事处跳转来的 区域不在改变
                return false;
            }
            if (prmData.area) {	//PRM跳转来的 区域不在改变
                return false;
            }
            $.each(dataArea, function (i, item) {
                areaHtml += '<option value="' + item.area + '">' + item.area + '</option>';
                if (office_type === false) {
                    $.each(item.office, function (j, dump) {
                        office_html += '<option value="' + dump + '">' + dump + '</option>';
                    })
                    office_type = true;
                }
            });
            break;
    }

    $("#area").empty().append(areaHtml);
    $("#office").empty().append(office_html);
    form.render();
}

//办事处跳转
function getOffice() {
    console.log('getOffice')
    let office_id = parent.$("#office_id").val();
    if (office_id) {
        if (parent.$("#office_type").val() == 2) {
            $('#devId').attr('readonly', 'true')
            $('#devSn').attr('readonly', 'true')
            $('#devIdNew').attr('readonly', 'true')
            $('#devSnNew').attr('readonly', 'true')

            var index = layer.msg('获取授权页面，请稍候...', {icon: 16, time: false, shade: 0.8});
            ajax_http(base_url + 'PlanNew/getOffice', {
                id: office_id,
                status: parent.$("#office_type").val()
            }, function (res) {
                if (parseInt(res.code) === -3) {
                    office2Data = res;
                }
                if (parseInt(res.code) === 0) {
                    layer.msg(res.msg, {icon: 1, time: 3000});
                    office2Data = res;
                    //区域处理
                    if (res.area) {
                        let html = '<option value="">请选择区域</option>',
                            office_html = '<option value="">请选择办事处</option>';
                        $.each(dataArea, function (i, item) {
                            if (item.area == res.area.area) {
                                html += '<option value="' + item.area + '" selected>' + item.area + '</option>';
                                $.each(item.office, function (j, dump) {
                                    if (dump == res.area.office) {
                                        office_html += '<option value="' + dump + '" selected>' + dump + '</option>';
                                    } else {
                                        office_html += '<option value="' + dump + '">' + dump + '</option>';
                                    }
                                })
                            } else {
                                html += '<option value="' + item.area + '">' + item.area + '</option>';
                            }
                        });

                        $("#area").empty().append(html);
                        $("#office").empty().append(office_html);
                        form.render();
                    }

                    //产品线处理
                    let html, version_option_html = false;
                    for (let i = 0; i < dataPlan.length; i++) {
                        if (dataPlan[i]['version'].length > 0) {

                            if (dataPlan[i]['plid'] == res.plan.plan_id) {
                                html += '<option value="' + dataPlan[i]['plid'] + '" selected>' + dataPlan[i]['plname'] + '</option>>';

                                $.each(dataPlan[i]['version'], function (j, item) {
                                    if (item.v_id == res.plan.id) {
                                        version_option_html += '<option value="' + item.value + '" selected>' + item.filed + '</option>';
                                        checkVersion(dataPlan[i]['plid'], item.v_id);
                                    } else {
                                        version_option_html += '<option value="' + item.value + '">' + item.filed + '</option>';
                                    }
                                });
                            } else {
                                html += '<option value="' + dataPlan[i]['plid'] + '">' + dataPlan[i]['plname'] + '</option>>';
                            }
                        }
                    }
                    if (!version_option_html) {
                        for (let i = 0; i < dataPlan.length; i++) {
                            if (dataPlan[i]['version'].length > 0) {

                                if (dataPlan[i]['plname']) {
                                    html = '<option value="' + dataPlan[i]['plid'] + '" selected>' + dataPlan[i]['plname'] + '</option>>';

                                    $.each(dataPlan[i]['version'], function (j, item) {
                                        if (j === 0) {
                                            version_option_html = '<option value="' + item.value + '" selected>' + item.filed + '</option>';
                                            checkVersion(dataPlan[i]['plid'], item.v_id);
                                        }
                                    });
                                    break;
                                }
                            }
                        }
                    }
                    $("#plname").empty().append(html);
                    $("#cloudVersion").empty().append(version_option_html);
                    form.render();

                } else {
                    if (parseInt(res.status) === 2) {
                        if (res.data.IdCode || res.data.ProductSnCode) {
                            $("#devId").val(res.data.IdCode);
                            $("#devSn").val(res.data.ProductSnCode);
                            // var oldDevID = $('#devId').val();
                            // var oldDevSn = $('#devSn').val();
                            $('#devIdNew').val(res.data.IdCode)
                            $('#devSnNew').val(res.data.ProductSnCode)
                        }
                    }
                    office2Data = res;
                    layer.msg(res.msg, {icon: 2, time: 3000});

                }
            });
        }
    }
}

