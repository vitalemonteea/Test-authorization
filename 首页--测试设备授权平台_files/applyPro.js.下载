/** 借测校验进行中计数：>0 时禁用「立即获取」按钮（方案 C） */
var btDataCheckAjaxCount = 0;

function updateGetSnSubmitLock() {
    var locked = btDataCheckAjaxCount > 0;
    var $btn = $('button[lay-filter="getSn"]');
    if (!$btn.length) {
        return;
    }
    $btn.prop('disabled', locked);
    $btn.toggleClass('layui-btn-disabled', locked);
}

function beginGetSnBorrowCheck() {
    btDataCheckAjaxCount++;
    updateGetSnSubmitLock();
}

function endGetSnBorrowCheck() {
    btDataCheckAjaxCount = Math.max(0, btDataCheckAjaxCount - 1);
    updateGetSnSubmitLock();
}

/**
 * 与失焦借测请求一致的 POST 参数（供提交前二次校验复用）
 * @param {object} field 可选，来自 layui serialize 的 data.field；缺省则从 DOM 读取
 */
function buildGetBtDataPayload(field) {
    field = field || {};
    var sn = ('devSnNew' in field) ? field.devSnNew : $("#devSnNew").val();
    var devId = ('devIdNew' in field) ? field.devIdNew : $("#devIdNew").val();
    var area = ('area' in field) ? field.area : $("#area").val();
    var planDevType = ('planDevType' in field) ? field.planDevType : $("#planDevType").val();
    var plname = ('plname' in field) ? field.plname : $("#plname").val();
    var cloudVersion = ('cloudVersion' in field) ? field.cloudVersion : $("#cloudVersion").val();
    return {
        sn: sn || '',
        dev_id: devId || '',
        area: area,
        request_origin: 1,
        plan_dev_type: planDevType,
        btType: planDevType,
        plname: plname,
        cloudVersion: cloudVersion
    };
}

/**
 * 是否需在提交前先走借测接口（与 getAndCheckSnAndId 触发条件一致：已选软/硬且 SN/设备ID 至少填一个）
 */
function shouldPreCheckBorrowTest(field) {
    var pt = String(field.planDevType || '');
    if (pt !== '1' && pt !== '2') {
        return false;
    }
    var sn = (field.devSnNew || '').trim();
    var did = (field.devIdNew || '').trim();
    return !!(sn || did);
}

/**
 * 提交前借测接口返回是否允许继续走审核
 * code===0 为通过；code===6 为软/硬授权风险提示但仍可继续；code===9 为超期等强提示但仍允许发起授权
 */
function isBorrowTestResponseOk(res) {
    var code = parseInt(res.code, 10);
    return !isNaN(code) && (code === 0 || code === 6 || code === 9);
}

/**
 * 调用 PlanNew/checkAuditValue（原 submit(getSn) 内层逻辑）
 */
function runCheckAuditValueRequest(data) {
    $.ajax({
        type: 'POST',
        url: base_url + 'PlanNew/checkAuditValue',
        data: data.field,
        dataType: 'json',
        success: function (res) {
            if (res.code == 0) {
                var msg = "<span style='font-size:13px'>您输入的ID已超过授权次数（当前限制为2次）/授权参数限制。请选择操作：点击【取消申请】退至上一页重新填写。点击【继续申请】发起超额审批，需区域产品线售前主管及总部行销产品线批准，如审批被驳回，则需要重新填写授权信息请谨慎选择。</span><br/>";
                if (data.field.planDevType == 2) {
                    msg = "<span style='font-size:13px'>测试设备授权已超期。请选择操作:点击【取消申请】退出流程。点击【继续申请】发起超期审批，需区域产品线售前主管及总部行销产品线批准，如审批被驳回，则需要重新填写授权信息请谨选择。</span><br/>";
                }

                layer.open({
                    type: 0,
                    title: '温馨提示',
                    content: msg + res.data,
                    btn: ['继续申请', '取消申请'],
                    area: '50%',
                    yes: function (index) {
                        layer.close(index);
                        var w = ($(window).width() * 0.8);
                        var h = ($(window).height() * 1);
                        var index = layui.layer.open({
                            title: "授权超额审批信息",
                            type: 2,
                            content: base_url + "SysVersion/excessApplication?newGuid=" + res.newGuid,
                            area: [w + 'px', h + 'px'],
                            success: function (layero, index) {
                                var body = layui.layer.getChildFrame('body', index);
                                body.find("#over_param").html(res.data);
                                body.find("#new_guid").val(res.newGuid);
                                body.find("#area").val(data.field.area);
                                body.find("#office").val(data.field.office);
                                if (res.bt_type == '办事处借测') {
                                    body.find("#area").val(res.area);
                                    body.find("#office").val(res.bureau);
                                }
                                body.find("#devId").val(data.field.devId);
                                body.find("#devSn").val(data.field.devSn);
                                var planDevType = '';
                                if (data.field.planDevType == 1) {
                                    planDevType = '软件';
                                } else if (data.field.planDevType == 2) {
                                    planDevType = '硬件';
                                }
                                body.find("#auth_type").val(planDevType);
                                body.find("#planName").val(res.planName);
                                body.find("#version").val(res.version);
                                body.find("#duration").val(res.duration);
                                body.find("#maxDate").val(res.maxDate);
                            }
                        });
                    },
                    btn2: function (index) {
                        if (res.file) {
                            if (res.file.length > 0) {
                                for (var i = 0; i < res.file.length; i++) {
                                    $("[name='" + res.file[i] + "']").addClass('borderRed');
                                }
                            }
                        }
                        layer.close(index);
                    }
                });
            } else if (res.code == 1) {
                submit(data);
            } else {
                layer.open({
                    type: 0,
                    title: '温馨提示',
                    content: '<div style="color:red;">' + res.msg + '</div>',
                    btn: ['确认'],
                    yes: function () {
                        layer.closeAll();
                    }
                });
            }
        }
    });
}

layui.use(['form', 'layedit', 'laydate', 'element', 'table'], function () {
    form = layui.form;
    layer = layui.layer;
    layedit = layui.layedit;
    laydate = layui.laydate;
    element = layui.element;
    table = layui.table;

    getArea();

    //产品线下拉框选择事件
    form.on('select(plname)', function (data) {
        clearBtInputData();//清空借测输入栏的数据
        checkPlan(data.value);
    });

    //版本下拉框选择事件
    form.on('select(cloudVersion)', function (data) {
        clearBtInputData();//清空借测输入栏的数据
        $.each(dataPlan, function (i, item) {
            if (item.plid == $("#plname").val()) {
                $.each(item['version'], function (j, dump) {
                    if (dump.value == data.value) {
                        checkVersion(item.plid, dump.v_id);
                    }
                })
            }
        })
    });

    //区域下拉框选择事件
    form.on('select(area)', function (data) {
        checkArea(data.value);
        ajax_http(base_url + '/BorrowTestCheck/checkAreaIsOverseas', {area: data.value}, function (res) {
            AreaIsOverseas= false;
            if (parseInt(res.code) === 0 &&parseInt(res.data)==1) {
                AreaIsOverseas= true;
                //海外区域，授权时间不在此需求影响范围，需要还原授权时间，即重算授权时间，还原
                $.each(dataPlan, function (i, item) {
                    if (item.plid == $("#plname").val()) {
                        let version = $("#cloudVersion").val();
                        $.each(item['version'], function (j, dump) {
                            if (dump.value == version) {
                                setVersionTime(item.plid, dump.v_id);
                            }
                        })
                    }
                })
            }
        });
    });
    laydate.render({
        elem: '#estimatedCompletionTime',
        value: '',
        trigger: 'click'
    });


    //设备类型选择
    form.on('select(planDevType)', function (data) {
        // 当【授权类型】=硬件授权，字段【SN】和【设备ID】都必填
        // 当【授权类型】=软件授权，【设备ID】必填（针对HCI 系统自动生成设备ID）
        switch (data.value) {
            case '1'://软件授权
                // $("#devSnNew").attr('lay-verify', '');
                $("#devSnNew").attr('readonly', 'readonly');
                $("#devIdNew").attr('lay-verify', 'required');
                // $("#devIdNew").attr('readonly', 'required');
                $("#devSnNew").val('');
                $('#devSnNew').removeAttr('lay-verify');
                $(".top-red").css("display", "")
                //软件类型隐藏借测类型输入框
                if(KeyIdStatus){
                    $("#associationDevSnView").hide();
                    $("#extrnal_sn").attr('lay-verify', '');
                }
                hideBtInputs();
                break;
            case '2':
                $("#devSnNew").attr('lay-verify', 'required');
                $("#devIdNew").attr('lay-verify', 'required');
                $('#devSnNew').removeAttr('readonly');
                $(".top-red").css("display", "none")
                if(KeyIdStatus){
                    // 当为EDR、CWPP、DMP、aES时不做展示
                    if ($.inArray(planid, ['11', '24', '137', '161']) == -1) {
                        $("#associationDevSnView").show();
                        $("#extrnal_sn").attr('lay-verify', 'required');
                    }
                }
                //硬件类型展示借测类型输入框
                showBtInputs();
                break
            default:
                break;
        }
        var devSnValue = $("#devSn").val();
        var devIdValue = $("#devId").val();
        getAndCheckSnAndId(devSnValue, devIdValue,null);
        let version = $("#cloudVersion").val();
        switch (version) {
            case 'EDR3.6.1':
                optinEDR('baseShow' + data.value);
                break;
            case 'EDR 3.2.26 ':
                optinEDR('baseShow' + data.value);
                break;
            case 'EDR3.2.21':
                optinEDR('baseShow' + data.value);
                break;
        }
    });
    //处理enter键问题
    $("#formsn input").keydown(function (event){
        console.log(event.keyCode)
        if(event.keyCode==13){
            return false;
        }
    })

    //数据提交（方案 A：需借测校验时先请求 getBtDataBySnOrDevId，通过后再 checkAuditValue）
    form.on("submit(getSn)", function (data) {
        if (data.field.planDevType == "") {
            layer.msg('请选择授权类型');
            return false;
        }

        if (!shouldPreCheckBorrowTest(data.field)) {
            runCheckAuditValueRequest(data);
            return false;
        }

        beginGetSnBorrowCheck();
        $.ajax({
            type: 'POST',
            url: base_url + "BorrowTestCheck/getBtDataBySnOrDevId",
            data: buildGetBtDataPayload(data.field),
            dataType: 'json',
            success: function (res) {
                if (!isBorrowTestResponseOk(res)) {
                    var msg = res.msg || '借测数据校验未通过，请根据提示修改后再提交';
                    layer.open({
                        type: 0,
                        title: '温馨提示',
                        content: '<div style="color:red;">' + msg + '</div>',
                        btn: ['确认'],
                        yes: function () {
                            layer.closeAll();
                        }
                    });
                    return;
                }
                var preCode = parseInt(res.code, 10);
                if ((preCode === 9 || preCode === 6) && res.msg) {
                    layer.msg(res.msg, { time: preCode === 6 ? 8000 : 6000 });
                }
                runCheckAuditValueRequest(data);
            },
            error: function () {
                layer.closeAll();
                layer.msg('借测数据校验失败，请稍后重试或联系管理员', {icon: 2, time: 2000});
            },
            complete: function () {
                endGetSnBorrowCheck();
            }
        });

        return false;
    });

    //EDR 测试项目申请原因
    form.on('select(testReason)', function (data) {
        optinEDR('testReason' + data.value);
    });
    if (dataDesign != null) {
        let item=[]
        for (item of dataDesign) {
            form.on('select(' + item.control_model_id + ')', function (data) {
                for (items of dataDesign) {
                    if (items.plan_id == planid && items.v_id == versionid && data.elem.name == items.control_model) {
                        var a = 0;
                        for (item1 of items.control_show) {
                            if ($.inArray(data.value, item1) != -1) {
                                $("." + items.ontrolled_model_id[a]).show();
                            } else {
                                $("." + items.ontrolled_model_id[a]).hide();
                            }
                            a++;
                        }
                    }
                }
            });
        }
    }
    //devSnNew的输入框，失去焦点
    $("#devSnNew").blur(function () {
        var devSnNew = $("#devSnNew").val();
        var planDevType=$('#planDevType').val();
        if (!devSnNew) {
            if(planDevType!=1){
                clearBtInputData();
            }
        } else {
            $("#devSn").val(devSnNew);
            getAndCheckSnAndId(devSnNew, '', null);
        }
    });

    //devIdNew的输入框，失去焦点
    $("#devIdNew").blur(function () {
        var devIdNew = $("#devIdNew").val();
        if (!devIdNew && !isAutoFill) {
            clearBtInputData();
        } else {
            $("#devId").val(devIdNew);
            getAndCheckSnAndId('', devIdNew, null);
        }
    });

    //关联设备的输入框，失去焦点
    $("#extrnal_sn").blur(function () {
        checkAssociatedDeviceSN();
    });

    //devSn的输入框，失去焦点；处理keyid问题
    $("#devSn").blur(function () {
        var devSnText = $("#devSnView").text();
        var devSnValue = $("#devSn").val();

        if (devSnText.indexOf("KEY ID") != -1) {
            $("#devIdNew").val(devSnValue);
            $("#devId").val(devSnValue);
            $("#devSnNew").val(devSnValue);
            $('#devIdNew').attr('readonly', 'true');
            $('#devSnNew').attr('readonly', 'true');

            getAndCheckSnAndId(devSnValue, devSnValue, devSnValue);
        }
    });
});

