/**
 * 判断字符串为1-8个0（为空字符串也返回false）
 * 返回false为不通过检测，返回true为通检测
 */
function checkStringZero(dataString) {
    if (!dataString) {
        return false;
    }
    var spam = ['', ' ', '0', '00', '000', '0000', '00000', '000000', '0000000', '0000000'];
    return !$.inArray(dataString, spam);
}

/**
 * 超720天的借测续期，改为只能续期一个月的展示
 */
function modifyTime() {
    //console.log('modifyTime');
    //获取当前所有的input
    time_id_arrs=[];
    $.each($("input"), function (key, value) {
        var inputValue = $(value).val() + '';

        //时间字符串转时间戳
        var newTime = Date.parse(new Date(inputValue))

        //时间戳转时间字符串yyyy-mm-dd
        var date = new Date(newTime);
        var y = date.getFullYear();
        var m = date.getUTCMonth() + 1;
        var d = date.getUTCDate();
        var M = m >= 10 ? m : '0' + m;
        var D = d >= 10 ? d : '0' + d;
        var timeDate = y + '-' + M + '-' + D;
        if (value.className=='layui-input temp_time' && value.placeholder.indexOf('开始时间')==-1){
            time_id_arrs.push(value.id)
        }
        if(value.className=='layui-input temp_time a'){
            return true;
        }
        //时间格式，要转换
        if (inputValue && inputValue.length == 10 && timeDate == inputValue && value.placeholder.indexOf('开始时间')==-1) {
            //当前时间
            date = new Date();
            date.setDate(date.getDate() + 30) //获取dayNum天后的日期
            Y = date.getFullYear();
            m = date.getMonth() + 1;
            d = date.getDate();
            M = m >= 10 ? m : '0' + m;
            D = d >= 10 ? d : '0' + d;
            oneMonthDate = Y + '-' + M + '-' + D;
            $(value).val(oneMonthDate);
            $(value).attr("readonly", "readonly");
        }
    });
    tempTimeTwo(time_id_arrs, setEndTime(0), oneMonthDate)
}

