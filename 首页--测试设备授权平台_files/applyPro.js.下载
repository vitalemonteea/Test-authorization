 * @param newSn
 * @param newId
 * @param forceId
 */
function getAndCheckSnAndId(newSn, newId, forceId) {
    if (newSn == '' && newId == '') {
        return false;
    }

    var btType = $("#planDevType").val();
    beginGetSnBorrowCheck();
    $.ajax({
        type: 'POST',
        url: base_url + "BorrowTestCheck/getBtDataBySnOrDevId",
        data: buildGetBtDataPayload({ devSnNew: newSn, devIdNew: newId }),
        dataType: 'json',
        success: function (_result) {
            var nestedFollowup = false;
            isAutoFill = false;
            if (_result.data && _result.data.id) {
                var data = _result.data;
                $("#tid").val(data.tid);
                $("#bt_no").val(data.tid);
                $("#bt_user").val(data.bt_user);
                $("#bt_status").val(data.bt_status);
                $("#bt_type").val(data.bt_type);

                //根据sn自动填充借测数据，置位
                if (data.dev_sn && !data.dev_id) {
                    isAutoFill = true;
                } else {
                    isAutoFill = false;
                }

                var devSnTxt = $("#devSnNew").val(),
                    devIdTxt = $("#devIdNew").val();

                if (data.dev_sn && devSnTxt != data.dev_sn) {
                    $("#devSnNew").val(data.dev_sn);
                    $("#devSn").val(data.dev_sn);
                }
                if(data.dev_id==''){
                    $("#devIdNew").val(data.dev_id);
                    $("#devId").val(data.dev_id);
                }
                if(data.dev_sn==''){
                    $("#devSnNew").val(data.dev_sn);
                    $("#devSn").val(data.dev_sn);
                }
                //强制赋值
                if (forceId) {
                    $("#devIdNew").val(forceId);
                    $("#devId").val(forceId);
                    // return true;
                } else if (data.dev_id && devIdTxt != data.dev_id) {
                    $("#devIdNew").val(data.dev_id);
                    $("#devId").val(data.dev_id);
                }
                // 软件授权code为6,时间限制为一个月
