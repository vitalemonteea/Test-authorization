function setEndTime(value){
    let date = new Date();
    date.setDate(date.getDate() + parseInt(value)) //获取dayNum天后的日期
    var Y = date.getFullYear();
    var M = date.getMonth();
    var D = date.getDate();
    let _M = M + 1 >= 10 ? (M + 1) : '0' + (M + 1);
    let _D = D >= 10 ? D : '0' + D;
    let endTime = Y + '-' + _M + '-' + _D;
    return endTime;
}
