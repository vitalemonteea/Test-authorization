//区域切换到海外，重新根据版本选中,调整授权时间
function setVersionTime(plan_id, version_id,type=0) {
    ajax_http(base_url + '/temp/getTemp', {plan_id: plan_id, v_id: version_id}, function (res) {
        if (parseInt(res.code) === 0) {
            //时间设置
            setTimeTemp(res.data.base, res.data.auth, version_id,type);
        }
    });
}
//模板设置
function setTimeTemp(base, auth, version_id = '',type=0) {
    let inputTime = setEndTime(90);
    let inputTime_str = setEndTime(0);
    let time_id_arr = [];
    for (let i = 0; i < auth.length; i++) {
        let auth_child = auth[i].temp;
        for (let j = 0; j < auth_child.length; j++) {
            switch (parseInt(auth_child[j].type)) {
                case 2: //时间
                    let time_id = 'y' + $.md5(auth_child[j].f_field + auth_child[j].field + '_time');
                    time_id_arr.push(time_id);
                    newtime = parseInt(new Date().getTime() / 1000);
                    timeRubbing = parseInt((parseInt(auth_child[j].input_max) - newtime) / 86400) + 1;
                    if ((timeRubbing) < 90 && timeRubbing > 0) {
                        inputTime = setEndTime(timeRubbing)
                    }
                    break;
            }
        }
    }
    //获取当前所有的input
    time_id_arrs = [];
    $.each($("input"), function (key, value) {
        if (value.className == 'layui-input temp_time') {
            if (value.placeholder.indexOf('开始时间') == -1) {
                time_id_arrs.push(value.id)
                $(value).val(inputTime);
            }
            $(value).attr("readonly", "readonly");
        }
    });
    if(type>0){
        inputTime = setEndTime(type);
    }
    //时间输入框
    tempTimeTwo(time_id_arrs, setEndTime(0), inputTime)
}

//产品线数据获取
function getPlan() {
    let show_type = 1;
    if (getQueryVariable('show_type') == 'test') {
        show_type = 2;
    }
    let office_id = parent.$("#office_id").val();
    if (!office_id) {
        office_id = 0;
    }
    ajax_http(base_url + 'PlanNew/palnVersionList', {show_type: show_type, id: office_id}, function (res) {
        if (parseInt(res.code) === 0) {
            let html, version_option_html = false;
            dataPlan = res.data;
            for (let i = 0; i < dataPlan.length; i++) {
                if (dataPlan[i]['version'].length > 0) {
                    html += '<option value="' + dataPlan[i]['plid'] + '">' + dataPlan[i]['plname'] + '</option>>';

                    //产品线对应版本 版本数据处理
                    if (version_option_html === false) {
                        $.each(dataPlan[i]['version'], function (j, item) {
                            version_option_html += '<option value="' + item.value + '">' + item.filed + '</option>';
                            if (j === 0) {
                                //PRM 办事处跳转 这里不走
