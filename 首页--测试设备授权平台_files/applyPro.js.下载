function daysBetween(date1String, date2String) {
    const oneDay = 24 * 60 * 60 * 1000; // 每天的毫秒数
    const date1 = new Date(date1String); // 当前时间
    const date2 = new Date(date2String); // 指定时间
    const diffTime = Math.abs(date2 - date1); // 计算两个日期之间的差值
    return Math.round(diffTime / oneDay); // 返回相隔的天数
}

